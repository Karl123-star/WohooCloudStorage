<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wohoo Cloud — Store, Share, Sync Beautifully</title>
  <meta name="description" content="Wohoo Cloud landing page with a purple-indigo visual identity, tilted photo-frame design, and mobile app download CTA." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --purple-1: #f5f1ff;
      --purple-2: #8b5cf6;
      --purple-3: #6d42ee;
      --indigo: #4f46e5;
      --indigo-deep: #2f2a86;
      --violet-ink: #211a46;
      --text: #201d33;
      --muted: #655f83;
      --line: rgba(98, 77, 196, 0.18);
      --white: #ffffff;
      --panel: rgba(255, 255, 255, 0.68);
      --shadow: 0 24px 70px rgba(72, 49, 168, 0.16);
      --shadow-strong: 0 28px 90px rgba(59, 39, 146, 0.28);
      --radius-xl: 32px;
      --radius-lg: 24px;
      --radius-md: 18px;
      --radius-sm: 14px;
      --max: 1240px;
      --nav-h: 84px;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      padding: 0;
      color: var(--text);
      font-family: "Manrope", sans-serif;
      background:
        radial-gradient(circle at 8% 10%, rgba(139, 92, 246, 0.18), transparent 28%),
        radial-gradient(circle at 92% 18%, rgba(79, 70, 229, 0.16), transparent 30%),
        radial-gradient(circle at 50% 120%, rgba(139, 92, 246, 0.14), transparent 40%),
        linear-gradient(180deg, #faf8ff 0%, #f6f2ff 46%, #ffffff 100%);
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(99, 77, 196, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(99, 77, 196, 0.035) 1px, transparent 1px);
      background-size: 32px 32px;
      mask-image: radial-gradient(circle at center, black 40%, transparent 95%);
      z-index: -1;
    }

    img {
      max-width: 100%;
      display: block;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button {
      font: inherit;
    }

    .container {
      width: min(calc(100% - 32px), var(--max));
      margin: 0 auto;
    }

    .reveal {
      opacity: 0;
      transform: translateY(34px) scale(0.98);
      transition: opacity 0.7s ease, transform 0.8s cubic-bezier(.2,.8,.2,1);
    }

    .reveal.is-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    .stagger > * {
      opacity: 0;
      transform: translateY(22px);
      animation: riseIn 0.8s cubic-bezier(.2,.8,.2,1) forwards;
    }

    .stagger > *:nth-child(1) { animation-delay: 0.08s; }
    .stagger > *:nth-child(2) { animation-delay: 0.16s; }
    .stagger > *:nth-child(3) { animation-delay: 0.24s; }
    .stagger > *:nth-child(4) { animation-delay: 0.32s; }
    .stagger > *:nth-child(5) { animation-delay: 0.40s; }

    @keyframes riseIn {
      from {
        opacity: 0;
        transform: translateY(22px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes floaty {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
    }

    @keyframes drift {
      0%, 100% { transform: rotate(0deg) translateY(0px); }
      50% { transform: rotate(1.2deg) translateY(-8px); }
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(16px);
      background: rgba(250, 247, 255, 0.72);
      border-bottom: 1px solid rgba(99, 77, 196, 0.08);
    }

    .nav {
      min-height: var(--nav-h);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand-header {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
    }

    .title {
      color: #5C6AC4;
    }

    .logo{
      width:44px;
      height:44px;
      border-radius:16px;
      background:
        radial-gradient(circle at 30% 30%, rgba(255,255,255,0.8), transparent 30%),
        linear-gradient(135deg, var(--purple-2), var(--indigo));
      box-shadow:0 16px 35px rgba(90,63,216,0.28);
      position:relative;
      overflow:hidden;
    }

    .logo::after{
      content:"";
      position:absolute;
      inset:11px;
      border-radius:12px 12px 5px 5px;
      background:rgba(255,255,255,0.88);
      clip-path:polygon(12% 18%, 66% 18%, 86% 38%, 86% 82%, 12% 82%);
    }

    .brand{
      font-family: "Space Grotesk", sans-serif;
      font-weight:700;
      font-size:clamp(1.1rem, 3vw, 1.35rem);
      letter-spacing: -0.02em;
    }

    .nav-links {
      display: none;
      align-items: center;
      gap: 28px;
      color: var(--muted);
      font-weight: 700;
      font-size: 0.96rem;
    }

    .nav-links a {
      position: relative;
      transition: color 0.25s ease;
    }

    .nav-links a::after {
      content: "";
      position: absolute;
      left: 0;
      bottom: -7px;
      width: 100%;
      height: 2px;
      background: linear-gradient(90deg, var(--purple-2), var(--indigo));
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.25s ease;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-links a:hover::after {
      transform: scaleX(1);
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .menu-btn {
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.72);
      width: 46px;
      height: 46px;
      border-radius: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: var(--violet-ink);
      cursor: pointer;
      box-shadow: var(--shadow);
      transition: transform 0.2s ease, background 0.2s ease;
    }

    .menu-btn:hover {
      transform: translateY(-2px);
      background: white;
    }

    .menu-btn svg {
      width: 22px;
      height: 22px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 54px;
      padding: 0 22px;
      border-radius: 999px;
      border: 1px solid transparent;
      font-weight: 800;
      letter-spacing: -0.01em;
      transition: transform 0.25s ease, box-shadow 0.25s ease, background 0.25s ease, border-color 0.25s ease;
      cursor: pointer;
      white-space: nowrap;
    }

    .btn:active {
      transform: translateY(1px) scale(0.985);
    }

    .btn-primary {
      color: white;
      background: linear-gradient(135deg, var(--purple-2), var(--indigo));
      box-shadow: 0 18px 35px rgba(93, 71, 221, 0.28);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 42px rgba(93, 71, 221, 0.34);
    }

    .btn-secondary {
      color: var(--violet-ink);
      background: rgba(255, 255, 255, 0.78);
      border-color: var(--line);
      backdrop-filter: blur(12px);
      box-shadow: var(--shadow);
    }

    .btn-secondary:hover {
      transform: translateY(-2px);
      background: rgba(255,255,255,0.95);
    }

    .mobile-nav {
      display: grid;
      grid-template-rows: 0fr;
      transition: grid-template-rows 0.35s ease;
    }

    .mobile-nav.open {
      grid-template-rows: 1fr;
    }

    .mobile-nav-inner {
      overflow: hidden;
    }

    .mobile-panel {
      margin: 0 0 18px;
      padding: 18px;
      border: 1px solid var(--line);
      background: rgba(255,255,255,0.78);
      backdrop-filter: blur(14px);
      border-radius: 22px;
      box-shadow: var(--shadow);
      display: grid;
      gap: 14px;
    }

    .mobile-panel a {
      font-weight: 800;
      color: var(--violet-ink);
      padding: 8px 0;
    }

    .pricing-modal[hidden] {
      display: none;
    }

    .pricing-modal {
      position: fixed;
      inset: 0;
      z-index: 100;
      display: grid;
      place-items: center;
      padding: 20px;
      background: rgba(30, 23, 67, 0.55);
      backdrop-filter: blur(8px);
    }

    .pricing-dialog {
      position: relative;
      width: min(100%, 760px);
      padding: clamp(24px, 5vw, 42px);
      border: 1px solid rgba(255,255,255,0.8);
      border-radius: 30px;
      background: linear-gradient(180deg, #fff, #f7f4ff);
      box-shadow: var(--shadow-strong);
    }

    .pricing-dialog h2 {
      margin: 0 48px 10px 0;
      color: var(--violet-ink);
      font: 700 clamp(1.8rem, 4vw, 2.6rem)/1.05 "Space Grotesk", sans-serif;
      letter-spacing: -0.05em;
    }

    .pricing-intro {
      margin: 0 0 24px;
      color: var(--muted);
      line-height: 1.7;
    }

    .pricing-close {
      position: absolute;
      top: 18px;
      right: 18px;
      width: 42px;
      height: 42px;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: white;
      color: var(--violet-ink);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .pricing-plans {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .pricing-plan {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      padding: 26px;
      border: 1px solid rgba(110, 88, 214, 0.16);
      border-radius: 26px;
      background: linear-gradient(145deg, rgba(255,255,255,0.96), rgba(240,237,249,0.88));
      box-shadow: 0 18px 38px rgba(72, 49, 168, 0.12), inset 0 1px 0 rgba(255,255,255,0.95);
      transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .pricing-plan:hover {
      transform: translateY(-5px);
      box-shadow: 0 24px 48px rgba(72, 49, 168, 0.18), inset 0 1px 0 rgba(255,255,255,0.95);
    }

    .pricing-plan::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background: linear-gradient(125deg, rgba(255,255,255,0.62), transparent 34%, rgba(255,255,255,0.18) 68%, transparent);
      pointer-events: none;
    }

    .pricing-plan.premium {
      color: white;
      border-color: rgba(255, 207, 77, 0.62);
      background: linear-gradient(145deg, #7c55e8, #493bc0 72%, #302985);
      box-shadow: 0 20px 45px rgba(67, 47, 166, 0.3), inset 0 1px 0 rgba(255,255,255,0.28);
    }

    .pricing-plan.premium::after {
      content: "";
      position: absolute;
      width: 220px;
      height: 220px;
      right: -92px;
      top: -112px;
      z-index: -1;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 212, 76, 0.72) 0%, rgba(255, 190, 46, 0.28) 34%, transparent 70%);
      filter: blur(4px);
      animation: goldAura 3.8s ease-in-out infinite;
      pointer-events: none;
    }

    @keyframes goldAura {
      0%, 100% { transform: scale(0.9); opacity: 0.62; }
      50% { transform: scale(1.18); opacity: 1; }
    }

    .pricing-plan h3 {
      margin: 0 0 14px;
      font: 700 1.35rem "Space Grotesk", sans-serif;
    }

    .pricing-plan p {
      margin: 0;
      line-height: 1.7;
      color: var(--muted);
    }

    .pricing-plan.premium p {
      color: rgba(255,255,255,0.88);
    }

    .pricing-price {
      display: flex;
      align-items: baseline;
      gap: 7px;
      margin: 0 0 12px !important;
      color: #f7f5ff !important;
    }

    .pricing-price strong {
      display: inline-block;
      font: 700 clamp(2.7rem, 6vw, 4rem)/0.9 "Space Grotesk", sans-serif;
      letter-spacing: -0.08em;
      background: linear-gradient(145deg, #ffffff 8%, #d9d8e2 42%, #858594 58%, #ffffff 82%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      filter: drop-shadow(1px 2px 0 rgba(55, 48, 88, 0.45)) drop-shadow(0 5px 8px rgba(255,255,255,0.2));
    }

    .pricing-price span {
      color: #e9e8f2;
      font-weight: 800;
    }

    .pricing-plan:not(.premium) .pricing-price {
      color: var(--muted) !important;
    }

    .pricing-plan:not(.premium) .pricing-price span {
      color: var(--muted);
    }

    .pricing-earn-panel {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 14px;
      align-items: center;
      margin-top: 20px;
      padding: 20px;
      border: 1px solid rgba(110, 88, 214, 0.14);
      border-radius: 24px;
      background: linear-gradient(135deg, rgba(255,255,255,0.86), rgba(242,239,255,0.9));
      box-shadow: 0 16px 34px rgba(72, 49, 168, 0.1);
    }

    .pricing-earn-panel img {
      width: 72px;
      height: 72px;
      object-fit: contain;
      filter: none;
    }

    .pricing-earn-panel h4 {
      margin: 0 0 4px;
      color: var(--violet-ink);
      font: 700 1rem "Space Grotesk", sans-serif;
    }

    .pricing-earn-panel p {
      margin: 0;
      font-size: 0.86rem;
      line-height: 1.5;
    }

    .survey-links {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 14px;
    }

    .survey-link {
      display: inline-flex;
      min-height: 42px;
      padding: 0 16px;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      color: white;
      background: linear-gradient(135deg, var(--purple-2), var(--indigo));
      font-size: 0.86rem;
      font-weight: 800;
      box-shadow: 0 12px 24px rgba(93, 71, 221, 0.2);
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .survey-link-secondary {
      color: var(--violet-ink);
      background: rgba(255, 255, 255, 0.82);
      border: 1px solid var(--line);
      box-shadow: none;
    }

    .survey-link:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 30px rgba(93, 71, 221, 0.28);
    }

    @media (max-width: 560px) {
      .pricing-plans {
        grid-template-columns: 1fr;
      }
    }

    .hero {
      padding: clamp(28px, 4vw, 40px) 0 80px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 34px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      width: fit-content;
      padding: 10px 14px;
      border-radius: 999px;
      background: rgba(255,255,255,0.65);
      border: 1px solid rgba(99, 77, 196, 0.16);
      color: var(--violet-ink);
      font-weight: 800;
      font-size: 0.88rem;
      box-shadow: var(--shadow);
      backdrop-filter: blur(12px);
    }

    .eyebrow-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple-2), var(--indigo));
      box-shadow: 0 0 0 6px rgba(139, 92, 246, 0.12);
    }

    .hero-copy h1 {
      margin: 18px 0 16px;
      font-family: "Space Grotesk", sans-serif;
      font-size: clamp(2.7rem, 7vw, 6rem);
      line-height: 0.92;
      letter-spacing: -0.06em;
      max-width: 11ch;
    }

    .gradient-text {
      background: linear-gradient(135deg, var(--purple-3), var(--indigo), #7b61ff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-copy p {
      margin: 0;
      max-width: 58ch;
      font-size: clamp(1rem, 1.6vw, 1.15rem);
      line-height: 1.75;
      color: var(--muted);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 28px;
    }

    .store-btn {
      min-width: 196px;
      justify-content: flex-start;
      padding-left: 18px;
      padding-right: 22px;
      border-radius: 22px;
    }

    .store-btn .icon-wrap {
      width: 38px;
      height: 38px;
      border-radius: 12px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(255,255,255,0.12);
      flex-shrink: 0;
    }

    .store-btn small {
      display: block;
      font-size: 0.72rem;
      opacity: 0.86;
      font-weight: 700;
      line-height: 1.1;
    }

    .store-btn strong {
      display: block;
      font-size: 1rem;
      line-height: 1.2;
    }

    .hero-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 18px 28px;
      margin-top: 24px;
      color: var(--muted);
      font-weight: 700;
    }

    .hero-meta span {
      display: inline-flex;
      align-items: center;
      gap: 10px;
    }

    .hero-meta i {
      width: 10px;
      height: 10px;
      display: inline-block;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--purple-2), var(--indigo));
      box-shadow: 0 0 0 6px rgba(139, 92, 246, 0.08);
    }

    .visual-wrap {
      position: relative;
      min-height: 560px;
      display: grid;
      place-items: center;
      isolation: isolate;
    }

    .visual-wrap::before,
    .visual-wrap::after {
      content: "";
      position: absolute;
      border-radius: 50%;
      filter: blur(12px);
      z-index: -2;
    }

    .visual-wrap::before {
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(139, 92, 246, 0.28), transparent 68%);
      top: 30px;
      left: 10%;
    }

    .visual-wrap::after {
      width: 360px;
      height: 360px;
      background: radial-gradient(circle, rgba(79, 70, 229, 0.22), transparent 68%);
      right: 2%;
      bottom: 20px;
    }

    .device-core {
      position: relative;
      width: min(100%, 540px);
      min-height: 480px;
      border-radius: 36px;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.82), rgba(247,244,255,0.72)),
        linear-gradient(135deg, rgba(139, 92, 246, 0.22), rgba(79, 70, 229, 0.12));
      border: 1px solid rgba(255,255,255,0.8);
      box-shadow: var(--shadow-strong);
      backdrop-filter: blur(18px);
      overflow: hidden;
    }

    .device-core::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(135deg, rgba(139,92,246,0.10), transparent 40%),
        radial-gradient(circle at 80% 14%, rgba(79,70,229,0.18), transparent 28%);
      pointer-events: none;
    }

    .device-topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 16px 18px;
      border-bottom: 1px solid rgba(99, 77, 196, 0.1);
    }

    .traffic {
      display: flex;
      gap: 8px;
    }

    .traffic span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(114, 92, 212, 0.26);
    }

    .mini-pill {
      height: 12px;
      width: 102px;
      border-radius: 999px;
      background: linear-gradient(90deg, rgba(139,92,246,0.26), rgba(79,70,229,0.18));
    }

    .dashboard {
      padding: 24px;
      height: calc(100% - 61px);
      position: relative;
      overflow: hidden;
    }

    .dashboard-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 18px;
      height: 100%;
    }

    .stack-col {
      position: relative;
      min-height: 360px;
    }

    .frame {
      position: absolute;
      width: 220px;
      background: rgba(255,255,255,0.92);
      border: 1px solid rgba(110, 88, 214, 0.14);
      border-radius: 24px;
      box-shadow: 0 18px 42px rgba(77, 57, 171, 0.15);
      padding: 12px;
      backdrop-filter: blur(10px);
      transform-origin: center;
      transition: transform 0.35s ease, box-shadow 0.35s ease;
      animation: floaty 6s ease-in-out infinite;
    }

    .frame:hover {
      transform: translateY(-6px) rotate(0deg) !important;
      box-shadow: 0 24px 52px rgba(77, 57, 171, 0.22);
    }

    .frame::after {
      content: "";
      position: absolute;
      inset: 10px;
      border-radius: 18px;
      border: 1px solid rgba(102, 78, 202, 0.08);
      pointer-events: none;
    }

    .frame-art {
      height: 190px;
      border-radius: 18px;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at 30% 28%, rgba(255,255,255,0.82), transparent 20%),
        linear-gradient(135deg, rgba(139,92,246,0.95), rgba(79,70,229,0.88));
    }

    .frame-art.art-1 {
      background:
        radial-gradient(circle at 28% 30%, rgba(255,255,255,0.9), transparent 18%),
        linear-gradient(145deg, #8b5cf6 0%, #6d42ee 44%, #4f46e5 100%);
    }

    .frame-art.art-1::before {
      content: "";
      position: absolute;
      width: 72%;
      height: 72%;
      right: -8%;
      top: 18%;
      border-radius: 32px;
      background: rgba(255,255,255,0.14);
      transform: rotate(24deg);
    }

    .frame-art.art-1::after {
      content: "";
      position: absolute;
      left: 14%;
      bottom: 16%;
      width: 42%;
      height: 34%;
      border-radius: 50px;
      background: rgba(255,255,255,0.18);
      filter: blur(2px);
    }

